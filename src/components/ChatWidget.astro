---
// Bolla di chat flottante presente su tutte le pagine (vedi Layout.astro).
// Tutta la logica è client-side: cronologia salvata in localStorage per 3 giorni di
// inattività (vedi SESSION_DURATION_MS più sotto).
---
<div id="chat-widget" class="chat-widget">
  <div id="chat-hint" class="chat-hint" hidden>
    <span id="chat-hint-text"></span>
    <button id="chat-hint-close" class="chat-hint-close" aria-label="Chiudi suggerimento">×</button>
  </div>

  <button id="chat-toggle" class="chat-toggle" aria-label="Apri la chat con l'assistente virtuale" aria-expanded="false">
    <span class="chat-toggle-icon" aria-hidden="true">💬</span>
    <span class="chat-online-dot" aria-hidden="true"></span>
  </button>

  <div id="chat-panel" class="chat-panel" role="dialog" aria-label="Chat Magma 610" hidden>
    <div class="chat-panel-header">
      <span id="chat-panel-title">Magma 610</span>
      <button id="chat-close" class="chat-close" aria-label="Chiudi la chat">×</button>
    </div>
    <div id="chat-messages" class="chat-messages" aria-live="polite"></div>
    <form id="chat-form" class="chat-form">
      <input id="chat-input" type="text" autocomplete="off" />
      <button id="chat-send" type="submit"></button>
    </form>
  </div>
</div>

<style>
  .chat-widget { position: fixed; right: 24px; bottom: 24px; z-index: 200; font-family: var(--font-body); }

  .chat-toggle {
    position: relative;
    width: 60px; height: 60px; border-radius: 50%; border: none; cursor: pointer;
    background: var(--lava); color: var(--bianco); box-shadow: var(--shadow-card);
    display: flex; align-items: center; justify-content: center; font-size: 26px;
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .chat-toggle:hover { background: var(--lava-dark); transform: scale(1.05); }

  /* Puntino "online" pulsante: comunica che l'assistente virtuale è sempre disponibile. */
  .chat-online-dot {
    position: absolute; top: 2px; right: 2px; width: 14px; height: 14px;
    background: #3FB673; border: 2px solid var(--bianco); border-radius: 50%;
    animation: chat-pulse 2.2s infinite;
  }
  @keyframes chat-pulse {
    0% { box-shadow: 0 0 0 0 rgba(63, 182, 115, 0.55); }
    70% { box-shadow: 0 0 0 9px rgba(63, 182, 115, 0); }
    100% { box-shadow: 0 0 0 0 rgba(63, 182, 115, 0); }
  }

  .chat-hint {
    position: absolute; right: 72px; bottom: 14px; max-width: 230px;
    background: var(--bianco); color: var(--basalto); box-shadow: var(--shadow-card);
    border-radius: 14px 14px 4px 14px; padding: 12px 12px 12px 16px; font-size: 13.5px; line-height: 1.45;
    display: flex; align-items: flex-start; gap: 6px; cursor: pointer;
    animation: chat-hint-in 0.3s ease;
  }
  .chat-hint[hidden] { display: none; }
  .chat-hint-close {
    background: none; border: none; color: var(--cenere); font-size: 17px; line-height: 1;
    cursor: pointer; padding: 0 0 0 4px; flex-shrink: 0;
  }
  @keyframes chat-hint-in {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .chat-panel {
    position: absolute; right: 0; bottom: 76px;
    width: min(340px, calc(100vw - 32px));
    height: min(480px, calc(100vh - 140px));
    background: var(--bianco); border-radius: 16px; box-shadow: var(--shadow-card);
    display: flex; flex-direction: column; overflow: hidden;
    border: 1px solid rgba(28, 25, 23, 0.08);
  }
  /* Un normal declaration "author" (come .chat-panel sopra) ha sempre priorità sulla
     regola predefinita del browser [hidden]{display:none}, quindi va resa esplicita qui. */
  .chat-panel[hidden] { display: none; }

  .chat-panel-header {
    background: var(--basalto); color: var(--bianco); padding: 14px 16px;
    display: flex; align-items: center; justify-content: space-between;
    font-family: var(--font-display); font-size: 16px;
  }
  .chat-close {
    background: none; border: none; color: var(--bianco); font-size: 22px; line-height: 1;
    cursor: pointer; padding: 0 4px;
  }

  .chat-messages {
    flex: 1; overflow-y: auto; padding: 14px 16px; display: flex; flex-direction: column; gap: 10px;
  }
  .chat-msg { max-width: 85%; padding: 9px 13px; border-radius: 14px; font-size: 14px; line-height: 1.5; white-space: pre-wrap; }
  .chat-msg-user { align-self: flex-end; background: var(--azzurro-chiaro); color: var(--basalto); border-bottom-right-radius: 4px; }
  .chat-msg-assistant { align-self: flex-start; background: rgba(28, 25, 23, 0.06); color: var(--basalto); border-bottom-left-radius: 4px; }
  .chat-msg-loading { align-self: flex-start; color: var(--cenere); font-size: 13px; font-style: italic; }

  .chat-form { display: flex; gap: 8px; padding: 12px; border-top: 1px solid rgba(28, 25, 23, 0.08); }
  .chat-form input {
    flex: 1; border: 1px solid rgba(28, 25, 23, 0.15); border-radius: var(--r-pill);
    padding: 9px 14px; font-size: 14px; font-family: var(--font-body); color: var(--basalto);
  }
  .chat-form input:focus { outline: 2px solid var(--azzurro); outline-offset: 1px; }
  .chat-form button {
    background: var(--lava); color: var(--bianco); border: none; border-radius: var(--r-pill);
    padding: 9px 16px; font-size: 13.5px; font-weight: 700; cursor: pointer; white-space: nowrap;
  }
  .chat-form button:hover { background: var(--lava-dark); }
  .chat-form button:disabled { opacity: 0.6; cursor: default; }

  @media (max-width: 420px) {
    .chat-widget { right: 14px; bottom: 14px; }
    .chat-panel { right: -6px; }
    /* Sotto i 420px il fumetto a sinistra della bolla non ci sta: lo spostiamo sopra. */
    .chat-hint { right: -6px; bottom: 76px; max-width: calc(100vw - 44px); border-radius: 14px 14px 14px 4px; }
  }
</style>

<script>
  import { splitLocaleFromPath, type Locale } from '../i18n/locales';

  const MAX_MESSAGES = 40;
  const SESSION_STORAGE_KEY = 'magma610-chat-session';
  const SESSION_DURATION_MS = 3 * 24 * 60 * 60 * 1000; // 3 giorni di inattività

  const UI_TEXT: Record<Locale, { title: string; placeholder: string; send: string; greeting: string; error: string; hint: string }> = {
    it: { title: 'Magma 610', placeholder: 'Scrivi un messaggio…', send: 'Invia', greeting: 'Ciao! Sono l’assistente virtuale di Magma 610. Come posso aiutarti con il tuo soggiorno?', error: 'Errore di connessione. Riprova tra poco o contatta Veronique al +39 380 182 4545.', hint: 'Hai domande sul tuo soggiorno? Il nostro assistente virtuale è sempre a tua disposizione 👋' },
    es: { title: 'Magma 610', placeholder: 'Escribe un mensaje…', send: 'Enviar', greeting: 'Hola! Soy el asistente virtual de Magma 610. ¿En qué puedo ayudarte con tu estancia?', error: 'Error de conexión. Inténtalo de nuevo en breve o contacta a Veronique al +39 380 182 4545.', hint: '¿Tienes preguntas sobre tu estancia? Nuestro asistente virtual está siempre disponible 👋' },
    en: { title: 'Magma 610', placeholder: 'Type a message…', send: 'Send', greeting: 'Hi! I’m the Magma 610 virtual assistant. How can I help with your stay?', error: 'Connection error. Please try again shortly or contact Veronique at +39 380 182 4545.', hint: 'Questions about your stay? Our virtual assistant is always here for you 👋' },
    fr: { title: 'Magma 610', placeholder: 'Écrivez un message…', send: 'Envoyer', greeting: 'Bonjour ! Je suis l’assistant virtuel de Magma 610. Comment puis-je vous aider pour votre séjour ?', error: 'Erreur de connexion. Réessayez bientôt ou contactez Veronique au +39 380 182 4545.', hint: 'Des questions sur votre séjour ? Notre assistant virtuel est toujours disponible 👋' },
    de: { title: 'Magma 610', placeholder: 'Nachricht schreiben…', send: 'Senden', greeting: 'Hallo! Ich bin der virtuelle Assistent von Magma 610. Wie kann ich Ihnen zu Ihrem Aufenthalt helfen?', error: 'Verbindungsfehler. Bitte versuchen Sie es später erneut oder kontaktieren Sie Veronique unter +39 380 182 4545.', hint: 'Fragen zu Ihrem Aufenthalt? Unser virtueller Assistent ist jederzeit für Sie da 👋' },
  };

  interface ChatMessage { role: 'user' | 'assistant'; content: string }

  const widget = document.getElementById('chat-widget')!;
  const toggle = document.getElementById('chat-toggle')! as HTMLButtonElement;
  const panel = document.getElementById('chat-panel')! as HTMLDivElement;
  const closeBtn = document.getElementById('chat-close')! as HTMLButtonElement;
  const messagesEl = document.getElementById('chat-messages')! as HTMLDivElement;
  const form = document.getElementById('chat-form')! as HTMLFormElement;
  const input = document.getElementById('chat-input')! as HTMLInputElement;
  const sendBtn = document.getElementById('chat-send')! as HTMLButtonElement;
  const titleEl = document.getElementById('chat-panel-title')!;
  const hintEl = document.getElementById('chat-hint')! as HTMLDivElement;
  const hintTextEl = document.getElementById('chat-hint-text')!;
  const hintCloseBtn = document.getElementById('chat-hint-close')! as HTMLButtonElement;

  const { locale } = splitLocaleFromPath(window.location.pathname);
  const t = UI_TEXT[locale] ?? UI_TEXT.it;
  titleEl.textContent = t.title;
  input.placeholder = t.placeholder;
  sendBtn.textContent = t.send;
  hintTextEl.textContent = t.hint;

  // Cronologia persistita in localStorage per 3 giorni di inattività: sopravvive al
  // reload della pagina (e alla chiusura del browser) ma scade dopo SESSION_DURATION_MS
  // dall'ultimo messaggio, per non riesumare conversazioni troppo vecchie.
  function loadStoredHistory(): ChatMessage[] {
    try {
      const raw = localStorage.getItem(SESSION_STORAGE_KEY);
      if (!raw) return [];
      const parsed = JSON.parse(raw) as { history?: ChatMessage[]; updatedAt?: number };
      if (!parsed || !Array.isArray(parsed.history) || typeof parsed.updatedAt !== 'number') return [];
      if (Date.now() - parsed.updatedAt > SESSION_DURATION_MS) {
        localStorage.removeItem(SESSION_STORAGE_KEY);
        return [];
      }
      return parsed.history;
    } catch {
      return [];
    }
  }

  function saveHistory(): void {
    try {
      localStorage.setItem(SESSION_STORAGE_KEY, JSON.stringify({ history, updatedAt: Date.now() }));
    } catch {
      // Storage non disponibile (es. modalità privata, quota piena): la chat continua a
      // funzionare, semplicemente senza persistenza tra un reload e l'altro.
    }
  }

  const history: ChatMessage[] = loadStoredHistory();
  let greeted = history.length > 0;
  let sending = false;

  function appendMessage(role: 'user' | 'assistant' | 'loading', text: string): HTMLDivElement {
    const div = document.createElement('div');
    div.className = `chat-msg chat-msg-${role}`;
    div.textContent = text;
    messagesEl.appendChild(div);
    messagesEl.scrollTop = messagesEl.scrollHeight;
    return div;
  }

  // Doppia sicurezza: il marcatore va già rimosso lato server, ma per sicurezza lo
  // ripuliamo anche qui nel caso arrivasse ancora visibile.
  function stripUnansweredMarker(text: string): string {
    return text.replace(/\n?\[UNANSWERED:[\s\S]*?\]\s*$/, '').trim();
  }

  for (const msg of history) {
    appendMessage(msg.role, msg.content);
  }

  function openPanel() {
    hideHint();
    panel.hidden = false;
    toggle.setAttribute('aria-expanded', 'true');
    if (!greeted) {
      appendMessage('assistant', t.greeting);
      greeted = true;
    }
    input.focus();
  }

  function closePanel() {
    panel.hidden = true;
    toggle.setAttribute('aria-expanded', 'false');
  }

  // Fumetto che spiega la presenza dell'assistente virtuale: compare una sola volta per
  // sessione del browser (sessionStorage), solo se la chat non è già stata usata su
  // questo dispositivo (storia vuota) e solo se il pannello non è già aperto.
  const HINT_SEEN_KEY = 'magma610-chat-hint-seen';
  function hideHint() {
    hintEl.hidden = true;
  }
  try {
    if (history.length === 0 && !sessionStorage.getItem(HINT_SEEN_KEY)) {
      sessionStorage.setItem(HINT_SEEN_KEY, '1');
      setTimeout(() => {
        if (panel.hidden) hintEl.hidden = false;
      }, 2000);
    }
  } catch {
    // sessionStorage non disponibile: semplicemente non mostriamo il fumetto automatico.
  }
  hintEl.addEventListener('click', openPanel);
  hintCloseBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    hideHint();
  });

  toggle.addEventListener('click', () => {
    if (panel.hidden) openPanel();
    else closePanel();
  });
  closeBtn.addEventListener('click', closePanel);

  // Permette ad altre parti della pagina (es. il box "Chatta con noi" in home) di aprire il widget.
  window.addEventListener('magma-open-chat', openPanel);

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (sending) return;
    const value = input.value.trim();
    if (!value) return;

    input.value = '';
    history.push({ role: 'user', content: value });
    appendMessage('user', value);
    saveHistory();

    if (history.length > MAX_MESSAGES) {
      appendMessage('assistant', t.error);
      return;
    }

    sending = true;
    sendBtn.disabled = true;
    const loadingEl = appendMessage('loading', '…');

    try {
      const res = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages: history, lang: locale, page: window.location.pathname }),
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();
      const reply = stripUnansweredMarker(String(data.reply ?? ''));
      loadingEl.remove();
      history.push({ role: 'assistant', content: reply });
      appendMessage('assistant', reply);
      saveHistory();
    } catch (err) {
      loadingEl.remove();
      appendMessage('assistant', t.error);
    } finally {
      sending = false;
      sendBtn.disabled = false;
    }
  });
</script>

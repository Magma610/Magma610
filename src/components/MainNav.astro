---
import { NAV, TERRITORIO_SUBMENU, TERRITORIO_SLUGS } from '../i18n/nav';
import { localizePath, type Locale } from '../i18n/locales';

interface Props {
  lang: Locale;
  currentPath: string; // senza prefisso lingua
}
const { lang, currentPath } = Astro.props;
const nav = NAV[lang];
const submenu = TERRITORIO_SUBMENU[lang];

const isActive = (path: string) => currentPath === path;
---
<button type="button" id="nav-toggle" class="nav-toggle" aria-expanded="false" aria-controls="main-nav" aria-label={nav.menu}>
  <span></span><span></span><span></span>
</button>

<nav class="main-nav" id="main-nav">
  <a href={localizePath(lang, '/')} class={isActive('/') ? 'active' : ''}>{nav.home}</a>
  <a href={localizePath(lang, '/la-struttura')} class={isActive('/la-struttura') ? 'active' : ''}>{nav.struttura}</a>

  <details class="territorio-drop">
    <summary>{nav.territorio}</summary>
    <div class="territorio-panel">
      <a href={localizePath(lang, `/territorio/${TERRITORIO_SLUGS.trekking}`)}>{submenu.trekking}</a>
      <a href={localizePath(lang, `/territorio/${TERRITORIO_SLUGS.cantine}`)}>{submenu.cantine}</a>
      <a href={localizePath(lang, `/territorio/${TERRITORIO_SLUGS.alcantara}`)}>{submenu.alcantara}</a>
      <a href={localizePath(lang, `/territorio/${TERRITORIO_SLUGS.taormina}`)}>{submenu.taormina}</a>
      <a href={localizePath(lang, `/territorio/${TERRITORIO_SLUGS.catania}`)}>{submenu.catania}</a>
      <a href={localizePath(lang, `/territorio/${TERRITORIO_SLUGS.bici}`)}>{submenu.bici}</a>
      <a href={localizePath(lang, `/territorio/${TERRITORIO_SLUGS.morgagni}`)}>{submenu.morgagni}</a>
    </div>
  </details>

  <a href={localizePath(lang, '/blog')} class={currentPath.startsWith('/blog') ? 'active' : ''}>{nav.blog}</a>
  <a href={localizePath(lang, '/faq')} class={isActive('/faq') ? 'active' : ''}>{nav.faq}</a>
  <a href={localizePath(lang, '/contatti')} class={isActive('/contatti') ? 'active' : ''}>{nav.contatti}</a>
</nav>

<script>
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('main-nav');

  toggle?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('mobile-open');
    toggle.classList.toggle('is-open', !!isOpen);
    toggle.setAttribute('aria-expanded', String(!!isOpen));
  });
</script>

<style>
  .main-nav { display: flex; gap: 8px; align-items: center; background: var(--bianco); border: 1px solid rgba(28,25,23,0.12); border-radius: var(--r-pill); padding: 6px; box-shadow: var(--shadow-card); }
  .main-nav > a { font-size: 14px; color: var(--basalto); padding: 9px 16px; border-radius: var(--r-pill); font-weight: 600; transition: background .15s ease; }
  .main-nav > a:hover { background: var(--azzurro-chiaro); }
  .main-nav > a.active { background: var(--azzurro-scuro); color: var(--bianco); }

  .territorio-drop { position: relative; }
  .territorio-drop summary {
    font-size: 14px; color: var(--basalto); padding: 9px 16px; border-radius: var(--r-pill);
    font-weight: 600; cursor: pointer; list-style: none;
  }
  .territorio-drop summary::-webkit-details-marker { display: none; }
  .territorio-drop summary:hover { background: var(--azzurro-chiaro); }
  .territorio-drop[open] summary { background: var(--azzurro-scuro); color: var(--bianco); }
  .territorio-panel {
    position: absolute; top: calc(100% + 8px); left: 50%; transform: translateX(-50%);
    background: var(--bianco); border: 1px solid rgba(28,25,23,0.12); border-radius: 14px;
    box-shadow: var(--shadow-hover); padding: 8px; min-width: 210px; z-index: 200;
  }
  .territorio-panel a { display: block; padding: 10px 14px; border-radius: 8px; font-size: 14px; color: var(--basalto); white-space: nowrap; }
  .territorio-panel a:hover { background: var(--azzurro-chiaro); color: var(--lava); }

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 42px;
    height: 42px;
    border: 1px solid rgba(28,25,23,0.12);
    border-radius: var(--r-pill);
    background: var(--bianco);
  }
  .nav-toggle span {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--basalto);
    border-radius: 2px;
    transition: transform .2s ease, opacity .2s ease;
  }
  .nav-toggle.is-open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav-toggle.is-open span:nth-child(2) { opacity: 0; }
  .nav-toggle.is-open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  @media (max-width: 900px) {
    .nav-toggle { display: flex; order: -1; }
    .main-nav { display: none; }
    .main-nav.mobile-open {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 2px;
      position: fixed;
      top: 78px;
      left: 16px;
      right: 16px;
      background: var(--bianco);
      border: 1px solid rgba(28,25,23,0.12);
      border-radius: 16px;
      box-shadow: var(--shadow-hover);
      padding: 10px;
      z-index: 200;
    }
    .main-nav.mobile-open > a,
    .main-nav.mobile-open .territorio-drop summary {
      padding: 13px 16px;
    }
    .main-nav.mobile-open .territorio-panel {
      position: static;
      transform: none;
      box-shadow: none;
      border: none;
      margin-top: 2px;
      padding: 0 0 0 12px;
    }
  }
</style>

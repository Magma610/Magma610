---
import AmenityIcon from './AmenityIcon.astro';
import { serviziBase } from '../data/listings.js';

interface Listing {
  slug: string;
  name: string;
  airbnbUrl: string;
  tipo: string;
  ospiti: number;
  camereDaLetto: number | null;
  letti: number;
  bagni: number;
  descrizione: string;
  totaleServizi: number;
  foto: string[];
}

interface Props {
  listing: Listing;
}
const { listing } = Astro.props;
---

<div class="listing-card">
  <div class="listing-gallery">
    <a class="g-main" href={listing.airbnbUrl} target="_blank" rel="noopener">
      <img src={listing.foto[0]} alt={`${listing.name} - vista principale`} loading="lazy" />
    </a>
    {listing.foto.slice(1, 4).map((src, i) => (
      <a href={listing.airbnbUrl} target="_blank" rel="noopener">
        <img src={src} alt={`${listing.name} - foto ${i + 2}`} loading="lazy" />
      </a>
    ))}
    <a href={listing.airbnbUrl} target="_blank" rel="noopener" style="position:relative;">
      <img src={listing.foto[4]} alt={`${listing.name} - foto 5`} loading="lazy" />
      <span class="gallery-badge">Mostra tutte le foto</span>
    </a>
  </div>

  <div class="listing-body">
    <div class="listing-top">
      <h3>{listing.name}</h3>
      <span class="listing-badge-new">★ Novità</span>
    </div>
    <div class="listing-meta">
      {listing.tipo} · Pedara · <b>{listing.ospiti} ospiti</b>
      {listing.camereDaLetto ? ` · ${listing.camereDaLetto} camera da letto` : ' · Monolocale'}
      · {listing.letti} lett{listing.letti === 1 ? 'o' : 'i'} · {listing.bagni} bagno
    </div>

    <div class="listing-facts">
      <div class="fact"><AmenityIcon name="ospiti" />{listing.ospiti} ospiti</div>
      <div class="fact"><AmenityIcon name="camera" />{listing.camereDaLetto ? '1 camera da letto' : 'Monolocale'}</div>
      <div class="fact"><AmenityIcon name="letto" />{listing.letti} lett{listing.letti === 1 ? 'o' : 'i'}</div>
      <div class="fact"><AmenityIcon name="bagno" />{listing.bagni} bagno</div>
    </div>

    <p class="listing-desc">{listing.descrizione}</p>

    <h4 class="amenities-head">Cosa troverai</h4>
    <div class="amenities-grid">
      {serviziBase.map((s) => (
        <div class={`amenity ${s.nonDisponibile ? 'unavailable' : ''}`}>
          <AmenityIcon name={s.icona as any} />
          {s.label}
        </div>
      ))}
    </div>
    <a href={listing.airbnbUrl} target="_blank" rel="noopener" class="btn-outline">
      Mostra tutti e {listing.totaleServizi} i servizi
    </a>

    <div class="listing-cta-row">
      <span class="listing-price">Prezzi e disponibilità su Airbnb</span>
      <a href={listing.airbnbUrl} target="_blank" rel="noopener" class="btn-book">Prenota su Airbnb</a>
    </div>
  </div>
</div>

<style>
  .listing-card {
    border: 1px solid rgba(28, 25, 23, 0.10);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: var(--shadow-card);
    margin-bottom: 32px;
    background: var(--bianco);
  }
  .listing-gallery {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 4px;
    height: 380px;
  }
  .listing-gallery a { display: block; overflow: hidden; position: relative; }
  .listing-gallery img { width: 100%; height: 100%; object-fit: cover; transition: transform .3s ease; }
  .listing-gallery a:hover img { transform: scale(1.04); }
  .g-main { grid-row: 1 / 3; }
  .gallery-badge {
    position: absolute; right: 16px; bottom: 16px;
    background: var(--bianco); color: var(--basalto);
    font-size: 13px; font-weight: 700; padding: 9px 16px;
    border-radius: var(--r-pill); box-shadow: var(--shadow-card);
  }
  @media (max-width: 820px) {
    .listing-gallery { grid-template-columns: 1fr 1fr; grid-template-rows: 180px 180px; height: auto; }
    .g-main { grid-column: 1 / 3; grid-row: 1; }
  }
  @media (max-width: 560px) {
    .listing-gallery { grid-template-columns: 1fr; grid-template-rows: 220px; }
    .listing-gallery a:not(.g-main) { display: none; }
    .g-main { grid-column: 1; grid-row: 1; }
  }

  .listing-body { padding: 32px; }
  .listing-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; flex-wrap: wrap; margin-bottom: 6px; }
  .listing-top h3 { font-size: 26px; }
  .listing-badge-new { font-size: 12px; font-weight: 700; color: var(--ginestra); border: 1px solid var(--ginestra); padding: 4px 10px; border-radius: var(--r-pill); }
  .listing-meta { color: var(--cenere); font-size: 14.5px; margin-bottom: 18px; }
  .listing-meta b { color: var(--basalto); }
  .listing-facts { display: flex; gap: 24px; flex-wrap: wrap; padding: 18px 0; border-top: 1px solid rgba(28, 25, 23, 0.10); border-bottom: 1px solid rgba(28, 25, 23, 0.10); margin-bottom: 22px; }
  .fact { display: flex; align-items: center; gap: 8px; font-size: 14.5px; color: var(--basalto); }
  .fact :global(svg) { width: 20px; height: 20px; flex-shrink: 0; color: var(--azzurro); }
  .listing-desc { color: var(--basalto); font-size: 15px; line-height: 1.7; margin-bottom: 26px; max-width: 640px; }

  .amenities-head { font-size: 19px; margin-bottom: 16px; }
  .amenities-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px 24px; margin-bottom: 22px; }
  .amenity { display: flex; align-items: center; gap: 14px; font-size: 14.5px; }
  .amenity :global(svg) { width: 24px; height: 24px; flex-shrink: 0; color: var(--azzurro); }
  .amenity.unavailable { color: var(--cenere); text-decoration: line-through; opacity: 0.6; }
  @media (max-width: 560px) { .amenities-grid { grid-template-columns: 1fr; } }

  .listing-cta-row { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; margin-top: 24px; }
  .listing-price { font-size: 14px; color: var(--cenere); }
</style>

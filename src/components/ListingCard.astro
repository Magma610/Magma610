---
import { Picture, getImage } from 'astro:assets';
import AmenityIcon from './AmenityIcon.astro';
import AmenityIconSvg from './AmenityIconSvg.astro';
import { LISTING_UI } from '../i18n/listing-ui';
import { APARTMENT_DESCRIPTIONS } from '../i18n/apartments';
import { AMENITY_CATEGORIES, AMENITY_NOT_INCLUDED, AMENITY_LABELS, AMENITY_SVG_ICON_FILES, type AmenityItemDef } from '../i18n/amenities';
import { getCamereImage } from '../lib/camere-images';
import type { Locale } from '../i18n/locales';

interface Listing {
  slug: 'magma-104' | 'magma-102';
  name: string;
  airbnbUrl: string;
  ospiti: number;
  camereDaLetto: number | null;
  letti: number;
  bagni: number;
  serviziEsclusi?: string[];
  foto: string[];
}

interface Props {
  listing: Listing;
  lang: Locale;
}
const { listing, lang } = Astro.props;
const ui = LISTING_UI[lang];
const descrizione = APARTMENT_DESCRIPTIONS[listing.slug][lang];
const labels = AMENITY_LABELS[lang];
const esclusi = new Set(listing.serviziEsclusi ?? []);

const categories = AMENITY_CATEGORIES
  .map((cat) => ({ title: labels[cat.id], items: cat.items.filter((item) => !esclusi.has(item.id)) }))
  .filter((cat) => cat.items.length > 0);
const notIncluded = AMENITY_NOT_INCLUDED.filter((item) => !esclusi.has(item.id));

const allAvailable = categories.flatMap((cat) => cat.items);

// Anteprima compatta (icone ufficiali Airbnb): selezione ragionata di 11 servizi
// disponibili, rappresentativi tra le diverse categorie.
const QUICK_IDS = [
  'wifi', 'kitchen', 'street-parking', 'tv', 'washer',
  'ac', 'heating', 'hotwater', 'private-entrance', 'patio-balcony', 'co-alarm',
];
const quickPreview = QUICK_IDS
  .map((id) => allAvailable.find((item) => item.id === id))
  .filter((item): item is AmenityItemDef => !!item);

// Foto della galleria: ImageMetadata per il markup <Picture> (WebP/AVIF + srcset),
// e un array parallelo di URL ottimizzati (stringhe) per la lightbox, pilotata da JS.
const photoImages = listing.foto.map((p) => getCamereImage(p));
const lightboxPhotos = await Promise.all(
  photoImages.map((img) => getImage({ src: img, width: 1600, format: 'webp' }))
);
const lightboxUrls = lightboxPhotos.map((img) => img.src);
---

<div class="listing-card" id={listing.slug}>
  <div class="listing-header">
    <div class="listing-top">
      <h3>{listing.name}</h3>
      <a href={listing.airbnbUrl} target="_blank" rel="noopener" class="btn-book listing-book-top">{ui.bookOnAirbnb}</a>
    </div>
    <div class="listing-meta">
      {ui.tipo} · Pedara · <b>{listing.ospiti} {ui.ospiti}</b>
      {listing.camereDaLetto ? ` · 1 ${ui.camereDaLetto}` : ` · ${ui.monolocale}`}
      · {listing.letti} {listing.letti === 1 ? ui.letto : ui.letti} · {listing.bagni} {ui.bagno}
    </div>
  </div>

  <div class="listing-gallery" data-photos={JSON.stringify(lightboxUrls)}>
    <button type="button" class="g-item g-main" aria-label={`Apri la galleria foto di ${listing.name}`}>
      <Picture
        src={photoImages[0]}
        formats={['avif', 'webp']}
        widths={[400, 800, 1200]}
        sizes="(max-width: 560px) 100vw, (max-width: 820px) 50vw, 45vw"
        alt={`${listing.name}, appartamento vacanza a Pedara: foto principale`}
        loading="lazy"
      />
    </button>
    {listing.foto.slice(1, 4).map((_, i) => (
      <button type="button" class="g-item" aria-label={`Apri la galleria foto di ${listing.name}`}>
        <Picture
          src={photoImages[i + 1]}
          formats={['avif', 'webp']}
          widths={[300, 600]}
          sizes="(max-width: 560px) 50vw, (max-width: 820px) 25vw, 22vw"
          alt={`${listing.name}, appartamento vacanza a Pedara: foto ${i + 2}`}
          loading="lazy"
        />
      </button>
    ))}
    <button type="button" class="g-item g-last" aria-label={ui.seeAllPhotos}>
      <Picture
        src={photoImages[4]}
        formats={['avif', 'webp']}
        widths={[300, 600]}
        sizes="(max-width: 560px) 50vw, (max-width: 820px) 25vw, 22vw"
        alt={`${listing.name}, appartamento vacanza a Pedara: foto 5`}
        loading="lazy"
      />
      <span class="g-overlay">{ui.seeAllPhotos}</span>
    </button>
  </div>

  <div class="lightbox" role="dialog" aria-modal="true" aria-label={`Galleria foto ${listing.name}`}>
    <div class="lightbox-backdrop"></div>
    <button type="button" class="lightbox-close" aria-label="Chiudi galleria">✕</button>
    <button type="button" class="lightbox-nav lightbox-prev" aria-label="Foto precedente">‹</button>
    <img class="lightbox-img" src="" alt="" />
    <button type="button" class="lightbox-nav lightbox-next" aria-label="Foto successiva">›</button>
    <div class="lightbox-counter"></div>
  </div>

  <div class="listing-body">
    <div class="listing-facts">
      <div class="fact"><AmenityIcon name="ospiti" />{listing.ospiti} {ui.ospiti}</div>
      <div class="fact"><AmenityIcon name="camera" />{listing.camereDaLetto ? `1 ${ui.camereDaLetto}` : ui.monolocale}</div>
      <div class="fact"><AmenityIcon name="letto" />{listing.letti} {listing.letti === 1 ? ui.letto : ui.letti}</div>
      <div class="fact"><AmenityIcon name="bagno" />{listing.bagni} {ui.bagno}</div>
    </div>

    <p class="listing-desc">{descrizione}</p>

    <h4 class="amenities-head">{ui.whatYouFind}</h4>
    <div class="amenities-grid">
      {quickPreview.map((item) => (
        <div class="amenity amenity-svg">
          <AmenityIconSvg name={AMENITY_SVG_ICON_FILES[item.id]} />
          {labels[item.id]}
        </div>
      ))}
    </div>

    <button
      type="button"
      class="btn-outline amenities-toggle"
      aria-expanded="false"
      data-show={ui.showAllServices}
      data-hide={ui.showLessServices}
    >
      {ui.showAllServices}
    </button>

    <div class="amenities-full">
      <div class="amenities-full-inner">
        {categories.map((cat) => (
          <div class="amenity-category">
            <h5>{cat.title}</h5>
            <div class="amenities-grid">
              {cat.items.map((item) => (
                <div class="amenity amenity-svg">
                  <AmenityIconSvg name={AMENITY_SVG_ICON_FILES[item.id]} />
                  {labels[item.id]}
                </div>
              ))}
            </div>
          </div>
        ))}

        <div class="amenity-category">
          <h5>{labels['not-included-title']}</h5>
          <div class="amenities-grid">
            {notIncluded.map((item) => (
              <div class="amenity amenity-svg unavailable">
                <AmenityIconSvg name={AMENITY_SVG_ICON_FILES[item.id]} />
                {labels[item.id]}
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="listing-cta-row">
      <span class="listing-price">{ui.priceInfo}</span>
    </div>
  </div>
</div>

<script>
  function initListingGalleries() {
    document.querySelectorAll<HTMLElement>('.listing-card').forEach((card) => {
      const gallery = card.querySelector<HTMLElement>('.listing-gallery');
      const lightbox = card.querySelector<HTMLElement>('.lightbox');
      if (!gallery || !lightbox || lightbox.dataset.wired) return;
      lightbox.dataset.wired = 'true';

      const photos: string[] = JSON.parse(gallery.dataset.photos || '[]');
      const buttons = Array.from(gallery.querySelectorAll<HTMLButtonElement>('button.g-item'));
      const imgEl = lightbox.querySelector<HTMLImageElement>('.lightbox-img')!;
      const counterEl = lightbox.querySelector<HTMLElement>('.lightbox-counter')!;
      let current = 0;

      const show = (index: number) => {
        current = (index + photos.length) % photos.length;
        imgEl.src = photos[current];
        counterEl.textContent = `${current + 1} / ${photos.length}`;
      };
      const open = (index: number) => {
        show(index);
        lightbox.classList.add('is-open');
        document.body.style.overflow = 'hidden';
        lightbox.focus();
      };
      const close = () => {
        lightbox.classList.remove('is-open');
        document.body.style.overflow = '';
      };

      buttons.forEach((btn, i) => btn.addEventListener('click', () => open(i)));
      lightbox.querySelector('.lightbox-close')?.addEventListener('click', close);
      lightbox.querySelector('.lightbox-backdrop')?.addEventListener('click', close);
      lightbox.querySelector('.lightbox-prev')?.addEventListener('click', () => show(current - 1));
      lightbox.querySelector('.lightbox-next')?.addEventListener('click', () => show(current + 1));
      lightbox.tabIndex = -1;
      lightbox.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') close();
        if (e.key === 'ArrowLeft') show(current - 1);
        if (e.key === 'ArrowRight') show(current + 1);
      });
    });
  }

  function initAmenitiesToggle() {
    document.querySelectorAll<HTMLElement>('.listing-card').forEach((card) => {
      const toggle = card.querySelector<HTMLButtonElement>('.amenities-toggle');
      const full = card.querySelector<HTMLElement>('.amenities-full');
      if (!toggle || !full || toggle.dataset.wired) return;
      toggle.dataset.wired = 'true';

      toggle.addEventListener('click', () => {
        const isOpen = full.classList.toggle('is-open');
        toggle.setAttribute('aria-expanded', String(isOpen));
        toggle.textContent = isOpen ? (toggle.dataset.hide ?? '') : (toggle.dataset.show ?? '');
      });
    });
  }

  initListingGalleries();
  initAmenitiesToggle();
  document.addEventListener('astro:page-load', () => {
    initListingGalleries();
    initAmenitiesToggle();
  });
</script>

<style>
  .listing-card {
    border: 1px solid rgba(28, 25, 23, 0.10);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: var(--shadow-card);
    margin-bottom: 32px;
    background: var(--bianco);
  }
  .listing-header { padding: 28px 32px 20px; }
  .listing-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; flex-wrap: wrap; margin-bottom: 6px; }
  .listing-top h3 { font-size: 26px; }
  .listing-book-top { padding: 9px 20px; font-size: 13px; white-space: nowrap; }
  .listing-meta { color: var(--cenere); font-size: 14.5px; }
  .listing-meta b { color: var(--basalto); }

  .listing-gallery {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 4px;
    height: 380px;
  }
  .listing-gallery button.g-item { display: block; overflow: hidden; position: relative; width: 100%; height: 100%; padding: 0; margin: 0; border: 0; background: none; cursor: pointer; font: inherit; }
  .listing-gallery img { width: 100%; height: 100%; object-fit: cover; transition: transform .3s ease; }
  .listing-gallery button.g-item:hover img { transform: scale(1.04); }
  .g-main { grid-row: 1 / 3; }
  .g-overlay {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    background: rgba(28, 25, 23, 0.45); color: var(--bianco); font-size: 14px; font-weight: 600;
    text-align: center; padding: 12px; transition: background .15s ease;
  }
  .g-last:hover .g-overlay { background: rgba(28, 25, 23, 0.6); }
  @media (max-width: 820px) {
    .listing-gallery { grid-template-columns: 1fr 1fr; grid-template-rows: 180px 180px; height: auto; }
    .g-main { grid-column: 1 / 3; grid-row: 1; }
  }
  @media (max-width: 560px) {
    .listing-gallery { grid-template-columns: 1fr; grid-template-rows: 220px; }
    .listing-gallery button.g-item:not(.g-main) { display: none; }
    .g-main { grid-column: 1; grid-row: 1; }
  }

  .lightbox { display: none; position: fixed; inset: 0; z-index: 250; align-items: center; justify-content: center; }
  .lightbox.is-open { display: flex; }
  .lightbox-backdrop { position: absolute; inset: 0; background: rgba(28, 25, 23, 0.92); }
  .lightbox-img { position: relative; max-width: min(90vw, 1100px); max-height: 86vh; object-fit: contain; border-radius: 8px; box-shadow: 0 20px 60px rgba(0,0,0,0.5); }
  .lightbox-close, .lightbox-nav { position: absolute; z-index: 1; background: rgba(28, 25, 23, 0.55); color: var(--bianco); border: 0; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: background .15s ease; }
  .lightbox-close:hover, .lightbox-nav:hover { background: rgba(28, 25, 23, 0.8); }
  .lightbox-close { top: 20px; right: 20px; width: 44px; height: 44px; font-size: 18px; }
  .lightbox-nav { top: 50%; transform: translateY(-50%); width: 52px; height: 52px; font-size: 28px; line-height: 1; }
  .lightbox-prev { left: 16px; }
  .lightbox-next { right: 16px; }
  .lightbox-counter { position: absolute; bottom: 20px; left: 50%; transform: translateX(-50%); color: var(--bianco); font-size: 13px; background: rgba(28, 25, 23, 0.55); padding: 5px 14px; border-radius: var(--r-pill); }
  @media (max-width: 560px) {
    .lightbox-nav { width: 42px; height: 42px; font-size: 22px; }
    .lightbox-prev { left: 6px; }
    .lightbox-next { right: 6px; }
  }

  .listing-body { padding: 28px 32px 32px; }
  .listing-facts { display: flex; gap: 24px; flex-wrap: wrap; padding: 18px 0; border-top: 1px solid rgba(28, 25, 23, 0.10); border-bottom: 1px solid rgba(28, 25, 23, 0.10); margin-bottom: 22px; }
  .fact { display: flex; align-items: center; gap: 8px; font-size: 14.5px; color: var(--basalto); }
  .fact :global(svg) { width: 20px; height: 20px; flex-shrink: 0; color: var(--azzurro); }
  .listing-desc { color: var(--basalto); font-size: 15px; line-height: 1.7; margin-bottom: 26px; width: 100%; }

  .amenities-head { font-size: 19px; margin-bottom: 16px; text-align: center; }
  .amenity-category { margin-bottom: 22px; }
  .amenity-category h5 { font-size: 13px; text-transform: uppercase; letter-spacing: 0.04em; color: var(--cenere); margin-bottom: 12px; text-align: center; }
  .amenities-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px 24px; margin-bottom: 20px; }
  .amenity { display: flex; align-items: center; justify-content: center; gap: 14px; font-size: 14.5px; }
  .amenity :global(svg) { width: 20px; height: 20px; flex-shrink: 0; color: var(--azzurro); }
  .amenity-svg :global(svg) { width: 24px; height: 24px; color: var(--ginestra); }
  .amenity.unavailable { color: var(--cenere); text-decoration: line-through; opacity: 0.6; }
  .amenity.unavailable :global(svg) { color: var(--cenere); }
  @media (max-width: 560px) { .amenities-grid { grid-template-columns: 1fr; } }

  .amenities-toggle { display: block; width: max-content; margin: 0 auto; }
  .amenities-full { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .35s ease; }
  .amenities-full-inner { overflow: hidden; min-height: 0; padding-top: 22px; }
  .amenities-full.is-open { grid-template-rows: 1fr; }
  .amenities-full .amenity-category:last-child { margin-bottom: 0; }

  .listing-cta-row { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; margin-top: 24px; }
  .listing-price { font-size: 14px; color: var(--cenere); }
</style>

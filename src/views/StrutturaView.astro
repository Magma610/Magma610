---
import { Picture } from 'astro:assets';
import ListingCard from '../components/ListingCard.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { listings } from '../data/listings.js';
import { STRUTTURA } from '../i18n/struttura';
import { FAQ_PAGE, FAQ_CONDENSED_IDS } from '../i18n/faq';
import { getCamereImage } from '../lib/camere-images';
import { localizePath, type Locale } from '../i18n/locales';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = STRUTTURA[lang];

// Versione condensata della FAQ: solo le domande più rilevanti per decidere se prenotare.
const faqItems = FAQ_PAGE[lang].categories.flatMap((cat) => cat.items);
const condensedFaqItems = FAQ_CONDENSED_IDS
  .map((id) => faqItems.find((item) => item.id === id))
  .filter((item): item is (typeof faqItems)[number] => !!item);

// Foto delle aree comuni — corte esterna e vista dell'edificio dall'esterno.
const IMG_CORTE = getCamereImage('magma-102/11.jpg');
const IMG_ESTERNO = getCamereImage('magma-104/06.jpg');
---
<section class="wrap page-hero">
  <span class="eyebrow">{t.eyebrow}</span>
  <h1>{t.title}</h1>
  <p class="lead">{t.lead}</p>
</section>

<section class="wrap common-areas">
  <div class="common-photos">
    <Picture src={IMG_ESTERNO} formats={['avif', 'webp']} widths={[400, 800]} sizes="(max-width: 820px) 50vw, 400px" alt="Vista esterna dell'edificio" />
    <Picture src={IMG_CORTE} formats={['avif', 'webp']} widths={[400, 800]} sizes="(max-width: 820px) 50vw, 400px" alt="Corte esterna" />
  </div>
  <div class="common-text">
    <h2>{t.commonAreasTitle}</h2>
    <p>{t.commonAreasText}</p>
  </div>
</section>

<section class="wrap trust-strip">
  <h3>{t.trustTitle}</h3>
  <ul>
    {t.trustPoints.map((point) => <li>{point}</li>)}
  </ul>
</section>

<section class="wrap" id="appartamenti">
  <div class="section-head">
    <span class="eyebrow">{t.apartmentsEyebrow}</span>
    <h2>{t.apartmentsTitle}</h2>
    <p>{t.apartmentsLead}</p>
  </div>
  {listings.map((listing) => <ListingCard listing={listing} lang={lang} />)}
</section>

<section class="wrap faq-condensed">
  <div class="section-head">
    <h2>{t.faqTitle}</h2>
  </div>
  <FaqAccordion categories={[{ id: 'condensed', title: '', items: condensedFaqItems }]} columns={2} />
  <a href={localizePath(lang, '/faq')} class="faq-link">{t.faqLinkText}</a>
</section>

<style>
  .page-hero { padding-top: 56px; padding-bottom: 8px; max-width: 720px; }
  .page-hero .eyebrow { color: var(--ginestra); font-weight: 700; font-size: 14px; }
  .page-hero h1 { font-size: 44px; margin: 10px 0 14px; }
  .page-hero .lead { color: var(--cenere); font-size: 17px; }

  .common-areas { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; padding-top: 40px; padding-bottom: 40px; }
  .common-photos { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .common-photos img { width: 100%; height: 200px; border-radius: 16px; box-shadow: var(--shadow-card); object-fit: cover; }
  .common-photos img:last-child { margin-top: 28px; }
  .common-text h2 { font-size: 26px; margin-bottom: 16px; }
  .common-text p { color: var(--basalto); font-size: 15.5px; line-height: 1.75; }
  @media (max-width: 820px) { .common-areas { grid-template-columns: 1fr; } .common-photos img:last-child { margin-top: 0; } }

  .trust-strip { padding-top: 0; padding-bottom: 40px; }
  .trust-strip h3 { font-size: 19px; margin-bottom: 16px; }
  .trust-strip ul { list-style: none; display: flex; flex-direction: column; gap: 10px; }
  .trust-strip li { font-size: 15px; color: var(--basalto); padding-left: 26px; position: relative; }
  .trust-strip li::before { content: '✓'; position: absolute; left: 0; color: var(--lava); font-weight: 700; }

  .section-head { max-width: 640px; margin-bottom: 36px; }
  .section-head .eyebrow { color: var(--ginestra); font-weight: 700; font-size: 14px; }
  .section-head h2 { font-size: 32px; margin-top: 8px; }
  .section-head p { color: var(--cenere); font-size: 16px; margin-top: 10px; }

  .faq-condensed { padding-top: 8px; padding-bottom: 64px; max-width: 980px; }
  .faq-link { display: inline-block; margin-top: 22px; color: var(--azzurro); font-weight: 700; font-size: 14.5px; }
  .faq-link:hover { color: var(--azzurro-scuro); }
</style>

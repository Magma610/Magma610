---
import { render, type CollectionEntry } from 'astro:content';
import { BLOG_UI } from '../lib/blog-ui';
import { localizePath, type Locale } from '../i18n/locales';

interface Props {
  lang: Locale;
  post: CollectionEntry<'blog'>;
}
const { lang, post } = Astro.props;
const ui = BLOG_UI[lang];
const { Content } = await render(post);
---
<article>
  <header class="hero-post">
    <img src={post.data.immagine} alt={post.data.titolo} />
    <div class="hero-scrim"></div>
    <div class="hero-text wrap">
      <span class="eyebrow">{post.data.tema}</span>
      <h1>{post.data.titolo}</h1>
      <span class="post-date">
        {post.data.data.toLocaleDateString(ui.dateLocale, { day: 'numeric', month: 'long', year: 'numeric' })}
      </span>
    </div>
  </header>

  <div class="wrap post-wrap">
    <div class="post-body">
      <Content />
    </div>
    <a href={localizePath(lang, '/blog')} class="btn-outline">{ui.backToBlog}</a>
  </div>
</article>

<style>
  .hero-post { position: relative; min-height: 440px; display: flex; align-items: flex-end; overflow: hidden; }
  .hero-post img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero-scrim { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(28,25,23,0.10) 0%, rgba(28,25,23,0.20) 40%, rgba(28,25,23,0.80) 100%); }
  .hero-text { position: relative; z-index: 2; padding: 56px 32px; color: var(--bianco); }
  .hero-text .eyebrow { color: #E9C77E; font-weight: 700; font-size: 14px; }
  .hero-text h1 { font-size: 44px; margin: 10px 0 10px; max-width: 760px; }
  .post-date { color: rgba(255,252,247,0.8); font-size: 14px; display: block; }
  @media (max-width: 640px) { .hero-post { min-height: 340px; } .hero-text h1 { font-size: 30px; } }

  .post-wrap { padding-top: 48px; }
  .post-body { font-size: 17px; line-height: 1.85; color: var(--basalto); margin-bottom: 40px; max-width: 820px; }
  .post-body :global(h2) { font-size: 26px; margin: 36px 0 16px; max-width: 820px; }
  .post-body :global(p) { margin-bottom: 18px; }
  .post-body :global(ul) { margin: 0 0 18px 20px; }
  .post-body :global(li) { margin-bottom: 10px; }
</style>

---
import { CONTATTI } from '../i18n/contatti';
import type { Locale } from '../i18n/locales';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = CONTATTI[lang];
---
<section class="wrap page-hero">
  <span class="eyebrow">{t.eyebrow}</span>
  <h1>{t.title}</h1>
  <p class="lead">{t.lead}</p>
</section>

<section class="wrap contatti-grid">
  <div class="contatti-info">
    <h2>{t.whereTitle}</h2>
    <p>Via Faro Filadelfo, 102<br />95030 Pedara (CT), Sicilia<br />
    <a href="https://www.google.com/maps/place//data=!4m2!3m1!1s0x1313ffce9ecd373d:0x7a53f5429029af12" target="_blank" rel="noopener">{t.mapLink}</a></p>

    <h2>{t.writeTitle}</h2>
    <p><a href="tel:+393383497138">338 349 7138</a> {t.phoneNote}</p>

    <h2>{t.checkTitle}</h2>
    <p><em>{t.checkPlaceholder}</em></p>

    <h2>{t.bookingTitle}</h2>
    <p>{t.bookingText}</p>
    <div class="contatti-links">
      <a href="https://www.airbnb.it/rooms/1748467293214784281" target="_blank" rel="noopener" class="btn-outline">Magma 104 — Airbnb →</a>
      <a href="https://www.airbnb.it/rooms/1748595559509576063" target="_blank" rel="noopener" class="btn-outline">Magma 102 — Airbnb →</a>
    </div>
  </div>

  <div class="contatti-map-placeholder">
    <span>[Mappa Google Maps — da integrare]</span>
  </div>
</section>

<style>
  .page-hero { padding-top: 56px; padding-bottom: 16px; max-width: 720px; }
  .page-hero .eyebrow { color: var(--ginestra); font-weight: 700; font-size: 14px; }
  .page-hero h1 { font-size: 42px; margin: 10px 0 14px; }
  .page-hero .lead { color: var(--cenere); font-size: 17px; }

  .contatti-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; padding-top: 16px; }
  .contatti-info h2 { font-size: 19px; margin: 26px 0 8px; }
  .contatti-info h2:first-child { margin-top: 0; }
  .contatti-info p { color: var(--basalto); font-size: 15px; line-height: 1.7; }
  .contatti-links { display: flex; flex-direction: column; gap: 10px; margin-top: 14px; align-items: flex-start; }
  .contatti-map-placeholder {
    background: var(--pomice-light); border-radius: 20px; min-height: 340px;
    display: flex; align-items: center; justify-content: center;
    color: var(--cenere); font-size: 14px; text-align: center; padding: 24px;
  }
  @media (max-width: 820px) { .contatti-grid { grid-template-columns: 1fr; } }
</style>

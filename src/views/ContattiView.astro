---
import { CONTATTI } from '../i18n/contatti';
import { FAQ_PAGE } from '../i18n/faq';
import type { Locale } from '../i18n/locales';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = CONTATTI[lang];

// Orari e documento richiesto per il check-in: stessa fonte della pagina FAQ, per non duplicare il testo.
const faqItems = FAQ_PAGE[lang].categories.flatMap((cat) => cat.items);
const checkTimes = faqItems.find((item) => item.id === 'checkin-checkout-times');
const checkDocument = faqItems.find((item) => item.id === 'checkin-document');
---
<section class="wrap page-hero">
  <span class="eyebrow">{t.eyebrow}</span>
  <h1>{t.title}</h1>
  <p class="lead">{t.lead}</p>
</section>

<section class="wrap contatti-grid">
  <div class="contatti-info">
    <h2>{t.whereTitle}</h2>
    <p>Via Faro Filadelfo, 102, 104<br />95030 Pedara (CT), Sicilia<br />
    <a href="https://www.google.com/maps/place//data=!4m2!3m1!1s0x1313ffce9ecd373d:0x7a53f5429029af12" target="_blank" rel="noopener">{t.mapLink}</a></p>

    <h2>{t.writeTitle}</h2>
    <p>Veronique — <a href="tel:+393801824545">+39 380 182 4545</a> {t.phoneNote}</p>

    <h2>{t.checkTitle}</h2>
    {checkTimes && <p>{checkTimes.answer}</p>}
    {checkDocument && <p>{checkDocument.answer}</p>}

    <h2>{t.bookingTitle}</h2>
    <p>{t.bookingText}</p>
    <div class="contatti-links">
      <a href="https://www.airbnb.it/rooms/1748467293214784281" target="_blank" rel="noopener" class="btn-outline">Magma 104 — Airbnb →</a>
      <a href="https://www.airbnb.it/rooms/1748595559509576063" target="_blank" rel="noopener" class="btn-outline">Magma 102 — Airbnb →</a>
    </div>
  </div>

  <div class="contatti-map">
    <iframe
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3160.2121411411886!2d15.060494674924827!3d37.62069742102214!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x1313ffce9ecd373d%3A0x7a53f5429029af12!2sMagma%20610!5e0!3m2!1sit!2sit!4v1788430877912!5m2!1sit!2sit"
      width="600"
      height="450"
      style="border:0;"
      allowfullscreen
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"
      title="Mappa: posizione di Magma 610 a Pedara"
    ></iframe>
  </div>
</section>

<style>
  .page-hero { padding-top: 56px; padding-bottom: 16px; max-width: 720px; }
  .page-hero .eyebrow { color: var(--ginestra); font-weight: 700; font-size: 14px; }
  .page-hero h1 { font-size: 42px; margin: 10px 0 14px; }
  .page-hero .lead { color: var(--cenere); font-size: 17px; }

  .contatti-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; padding-top: 16px; padding-bottom: 96px; }
  .contatti-info h2 { font-size: 19px; margin: 26px 0 8px; }
  .contatti-info h2:first-child { margin-top: 0; }
  .contatti-info p { color: var(--basalto); font-size: 15px; line-height: 1.7; }
  .contatti-info p + p { margin-top: 8px; }
  .contatti-links { display: flex; flex-direction: column; gap: 10px; margin-top: 14px; align-items: flex-start; }
  .contatti-map {
    background: var(--azzurro-chiaro); border-radius: 20px; min-height: 340px;
    overflow: hidden;
  }
  .contatti-map iframe { display: block; width: 100%; height: 100%; min-height: 340px; }
  @media (max-width: 820px) { .contatti-grid { grid-template-columns: 1fr; } }
</style>

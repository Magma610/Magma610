---
import '../styles/global.css';
import CookieBanner from '../components/CookieBanner.astro';
import ChatWidget from '../components/ChatWidget.astro';
import MainNav from '../components/MainNav.astro';
import LanguageFlagSwitcher from '../components/LanguageFlagSwitcher.astro';
import LangAutoDetect from '../components/LangAutoDetect.astro';
import Breadcrumb, { type BreadcrumbItem } from '../components/Breadcrumb.astro';
import { NAV, FOOTER } from '../i18n/nav';
import { LOCALES, DEFAULT_LOCALE, localizePath, splitLocaleFromPath, type Locale } from '../i18n/locales';
import { listings } from '../data/listings.js';
import { getCamereImage } from '../lib/camere-images';

const firstApartmentSlug = listings[0].slug; // "magma-104" — il bottone Prenota in header punta lì

// Schema.org da emettere in pagina: il tipo dipende dalla natura della pagina.
// "lodging" (LodgingBusiness) resta riservato a Home, La Struttura e Contatti —
// le altre pagine passano un tipo più specifico, o "none" se non pertinente.
export type SchemaConfig =
  | { kind: 'lodging' }
  | { kind: 'touristAttraction'; name: string; description: string; image: string; geo?: { latitude: number; longitude: number } }
  | { kind: 'blogPosting'; headline: string; description: string; image: string; datePublished: string; dateModified?: string }
  | { kind: 'none' };

interface Props {
  lang: Locale;
  title: string;
  description: string;
  image?: string;
  currentPath?: string; // path senza prefisso lingua; se omesso, derivato dall'URL corrente
  schema?: SchemaConfig;
  breadcrumbItems?: BreadcrumbItem[]; // se omesso, nessun breadcrumb (es. home)
}

const {
  lang,
  title,
  description,
  image = '/images/logo/logo-quadrato.png',
  currentPath,
  schema = { kind: 'none' },
  breadcrumbItems,
} = Astro.props;

const path = currentPath ?? splitLocaleFromPath(Astro.url.pathname).path;
const canonicalURL = new URL(localizePath(lang, path), Astro.site);
const nav = NAV[lang];
const footer = FOOTER[lang];

// Il title passato da ogni pagina è già completo (es. le pagine territorio/FAQ includono
// già "— Magma 610, Pedara"): appendiamo il brand solo se non è già presente, per evitare
// title tag duplicati e troppo lunghi in SERP.
const fullTitle = title.toLowerCase().includes('magma 610') ? title : `${title} | Magma 610`;

const OG_LOCALE_MAP: Record<Locale, string> = { it: 'it_IT', es: 'es_ES', en: 'en_GB', fr: 'fr_FR', de: 'de_DE' };

function buildJsonLd(): Record<string, unknown> | null {
  switch (schema.kind) {
    case 'lodging':
      return {
        '@context': 'https://schema.org',
        '@type': 'LodgingBusiness',
        name: 'Magma 610 Bed and More',
        description: "B&B a conduzione diretta in pietra lavica a Pedara, sul versante sud dell'Etna. Due appartamenti indipendenti, Magma 102 e Magma 104.",
        address: {
          '@type': 'PostalAddress',
          streetAddress: 'Via Faro Filadelfo, 102, 104',
          addressLocality: 'Pedara',
          addressRegion: 'CT',
          postalCode: '95030',
          addressCountry: 'IT',
        },
        geo: {
          '@type': 'GeoCoordinates',
          latitude: 37.62069742102214,
          longitude: 15.060494674924827,
        },
        telephone: '+39 380 182 4545',
        url: 'https://www.magma610.it',
        image: new URL(getCamereImage('magma-104/06.jpg').src, Astro.site).toString(),
        priceRange: '€€',
        sameAs: [
          'https://www.airbnb.it/rooms/1748467293214784281',
          'https://www.airbnb.it/rooms/1748595559509576063',
        ],
      };
    case 'touristAttraction':
      return {
        '@context': 'https://schema.org',
        '@type': 'TouristAttraction',
        name: schema.name,
        description: schema.description,
        image: new URL(schema.image, Astro.site).toString(),
        url: canonicalURL.toString(),
        ...(schema.geo
          ? { geo: { '@type': 'GeoCoordinates', latitude: schema.geo.latitude, longitude: schema.geo.longitude } }
          : {}),
      };
    case 'blogPosting':
      return {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: schema.headline,
        description: schema.description,
        image: new URL(schema.image, Astro.site).toString(),
        datePublished: schema.datePublished,
        ...(schema.dateModified ? { dateModified: schema.dateModified } : {}),
        author: { '@type': 'Organization', name: 'Magma 610 Bed and More' },
        publisher: {
          '@type': 'Organization',
          name: 'Magma 610 Bed and More',
          logo: { '@type': 'ImageObject', url: new URL('/images/logo/logo-quadrato.png', Astro.site).toString() },
        },
        mainEntityOfPage: canonicalURL.toString(),
        url: canonicalURL.toString(),
      };
    case 'none':
      return null;
  }
}
const jsonLd = buildJsonLd();
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Font self-hosted da /public/fonts/ (vedi global.css) — niente più richieste a Google Fonts -->
  <link rel="preload" href="/fonts/fraunces-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/public-sans-latin.woff2" as="font" type="font/woff2" crossorigin />

  <link rel="icon" type="image/png" href="/images/logo/icona.png" />
  <link rel="canonical" href={canonicalURL} />

  <!-- hreflang: dice a Google che questa pagina esiste in altre lingue -->
  {LOCALES.map((loc) => (
    <link rel="alternate" hreflang={loc} href={new URL(localizePath(loc, path), Astro.site)} />
  ))}
  <link rel="alternate" hreflang="x-default" href={new URL(localizePath(DEFAULT_LOCALE, path), Astro.site)} />

  <title>{fullTitle}</title>
  <meta name="description" content={description} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(image, Astro.site)} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:locale" content={OG_LOCALE_MAP[lang]} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />

  <!-- Schema.org: tipo determinato dalla pagina, vedi prop "schema" -->
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

  {lang === DEFAULT_LOCALE && <LangAutoDetect />}
</head>
<body>
  <header>
    <div class="wrap header-inner">
      <a href={localizePath(lang, '/')} aria-label="Magma 610 - Home">
        <img class="logo-img" src="/images/logo/logo-orizzontale.png" alt="Magma 610 Bed and More" width="1307" height="251" />
      </a>
      <MainNav lang={lang} currentPath={path} />
      <div class="header-actions">
        <LanguageFlagSwitcher currentLocale={lang} currentPath={path} />
        <a href={`${localizePath(lang, '/la-struttura')}#${firstApartmentSlug}`} class="btn-book">{nav.prenota}</a>
      </div>
    </div>
  </header>

  <main>
    {breadcrumbItems && <Breadcrumb lang={lang} items={breadcrumbItems} />}
    <slot />
  </main>

  <footer>
    <div class="wrap">
      <div class="footer-grid">
        <div>
          <img class="footer-logo" src="/images/logo/logo-verticale.png" alt="Magma 610" width="1599" height="832" />
          <p>Via Faro Filadelfo, 102, 104<br />95030 Pedara (CT), Sicilia</p>
        </div>
        <div>
          <h4>{footer.bAndB}</h4>
          <a href={localizePath(lang, '/la-struttura')}>{nav.struttura}</a>
        </div>
        <div>
          <h4>{footer.resources}</h4>
          <a href={localizePath(lang, '/blog')}>{nav.blog}</a>
          <a href={localizePath(lang, '/contatti')}>{nav.contatti}</a>
          <a href={localizePath(lang, '/faq')}>{nav.faq}</a>
        </div>
        <div>
          <h4>{footer.book}</h4>
          <a href="https://www.airbnb.it/rooms/1748467293214784281" target="_blank" rel="noopener">Magma 104 — Airbnb</a>
          <a href="https://www.airbnb.it/rooms/1748595559509576063" target="_blank" rel="noopener">Magma 102 — Airbnb</a>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© {new Date().getFullYear()} Magma 610 Bed and More</span>
        <span class="footer-legal-links">
          <a href="/privacy-policy">{footer.legalPrivacy}</a> · <a href="/cookie-policy">{footer.legalCookie}</a>
        </span>
      </div>
    </div>
  </footer>

  <CookieBanner lang={lang} />
  <ChatWidget />
</body>
</html>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 252, 247, 0.96);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid rgba(28, 25, 23, 0.08);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 32px;
    gap: 16px;
  }
  .logo-img { height: 46px; width: auto; }
  .header-actions { display: flex; align-items: center; gap: 14px; }

  footer {
    background: var(--basalto);
    color: rgba(255, 252, 247, 0.85);
    padding: 56px 0 28px;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 36px;
    padding-bottom: 40px;
    border-bottom: 1px solid rgba(255, 252, 247, 0.14);
  }
  .footer-grid h4 {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ginestra);
    margin-bottom: 16px;
  }
  .footer-grid a, .footer-grid p {
    font-size: 14px;
    color: rgba(255, 252, 247, 0.75);
    display: block;
    margin-bottom: 9px;
  }
  .footer-logo { height: 70px; width: auto; margin-bottom: 14px; }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    padding-top: 22px;
    font-size: 13px;
    color: rgba(255, 252, 247, 0.5);
    flex-wrap: wrap;
    gap: 12px;
  }
  .footer-legal-links a { color: rgba(255, 252, 247, 0.5); text-decoration: underline; }
  .footer-legal-links a:hover { color: var(--bianco); }
  @media (max-width: 820px) {
    .footer-grid { grid-template-columns: 1fr 1fr; row-gap: 28px; }
  }
</style>

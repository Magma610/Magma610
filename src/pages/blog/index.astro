---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.data.valueOf() - a.data.data.valueOf()
);
---
<Layout
  title="Blog"
  description="Storie e itinerari dal versante sud dell'Etna: escursioni, cantine, punti d'interesse — aggiornati ogni settimana."
>
  <section class="wrap page-hero">
    <span class="eyebrow">Dal blog</span>
    <h1>Storie e itinerari dal versante sud</h1>
    <p class="lead">Consigli pratici su escursioni, cantine e punti d'interesse, aggiornati ogni settimana.</p>
  </section>

  <section class="wrap blog-grid">
    {posts.map((post) => (
      <a class="blog-card" href={`/blog/${post.id}`}>
        <div class="blog-photo"><img src={post.data.immagine} alt={post.data.titolo} /></div>
        <span class="blog-date">{post.data.data.toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
        <h3>{post.data.titolo}</h3>
        <p>{post.data.estratto}</p>
      </a>
    ))}
  </section>
</Layout>

<style>
  .page-hero { padding-top: 56px; padding-bottom: 16px; max-width: 720px; }
  .page-hero .eyebrow { color: var(--ginestra); font-weight: 700; font-size: 14px; }
  .page-hero h1 { font-size: 42px; margin: 10px 0 14px; }
  .page-hero .lead { color: var(--cenere); font-size: 17px; }

  .blog-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; padding-top: 16px; }
  .blog-card .blog-photo { aspect-ratio: 4/3; border-radius: 16px; overflow: hidden; margin-bottom: 16px; box-shadow: var(--shadow-card); }
  .blog-card .blog-photo img { width: 100%; height: 100%; object-fit: cover; transition: transform .3s ease; }
  .blog-card:hover .blog-photo img { transform: scale(1.04); }
  .blog-card .blog-date { font-size: 13px; color: var(--ginestra); font-weight: 700; margin-bottom: 8px; display: block; }
  .blog-card h3 { font-size: 18px; margin-bottom: 8px; color: var(--basalto); }
  .blog-card p { font-size: 14px; color: var(--cenere); }
  @media (max-width: 820px) { .blog-grid { grid-template-columns: 1fr; } }
</style>

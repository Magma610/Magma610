---
import Layout from '../../layouts/Layout.astro';
import BlogPostView from '../../views/BlogPostView.astro';
import { getCollection } from 'astro:content';
import { parsePostId, isPublished } from '../../lib/blog';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  return allPosts
    .filter(isPublished)
    .filter((p) => parsePostId(p.id).locale === 'it')
    .map((post) => ({
      params: { slug: parsePostId(post.id).slug },
      props: { post },
    }));
}

const { post } = Astro.props;
---
<Layout lang="it" title={post.data.titolo} description={post.data.estratto} image={post.data.immagine} currentPath={`/blog/${parsePostId(post.id).slug}`}>
  <BlogPostView lang="it" post={post} />
</Layout>

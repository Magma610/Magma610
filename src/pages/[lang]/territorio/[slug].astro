---
import Layout from '../../../layouts/Layout.astro';
import TerritorioDetailView from '../../../views/TerritorioDetailView.astro';
import { TERRITORIO_CONTENT, TERRITORIO_IMAGES, TERRITORIO_GEO, type TerritorioSlug } from '../../../i18n/territorio';
import { NAV, TERRITORIO_SUBMENU, TERRITORIO_KEY_BY_SLUG } from '../../../i18n/nav';
import type { Locale } from '../../../i18n/locales';

export function getStaticPaths() {
  const slugs = Object.keys(TERRITORIO_CONTENT) as TerritorioSlug[];
  const langs = ['es', 'en', 'fr', 'de'] as const;
  return langs.flatMap((lang) => slugs.map((slug) => ({ params: { lang, slug } })));
}

const { lang, slug } = Astro.params as { lang: Exclude<Locale, 'it'>; slug: TerritorioSlug };
const t = TERRITORIO_CONTENT[slug][lang];
const submenuLabel = TERRITORIO_SUBMENU[lang][TERRITORIO_KEY_BY_SLUG[slug]];
---
<Layout
  lang={lang}
  title={t.metaTitle}
  description={t.metaDescription}
  currentPath={`/territorio/${slug}`}
  schema={{
    kind: 'touristAttraction',
    name: t.title,
    description: t.metaDescription,
    image: TERRITORIO_IMAGES[slug],
    geo: TERRITORIO_GEO[slug],
  }}
  breadcrumbItems={[{ label: NAV[lang].territorio }, { label: submenuLabel }]}
>
  <TerritorioDetailView lang={lang} slug={slug} />
</Layout>

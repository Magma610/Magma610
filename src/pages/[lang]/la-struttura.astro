---
import Layout from '../../layouts/Layout.astro';
import StrutturaView from '../../views/StrutturaView.astro';
import { STRUTTURA } from '../../i18n/struttura';
import { NAV } from '../../i18n/nav';
import type { Locale } from '../../i18n/locales';

export function getStaticPaths() {
  return (['es', 'en', 'fr', 'de'] as const).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Exclude<Locale, 'it'> };
const t = STRUTTURA[lang];
---
<Layout
  lang={lang}
  title={t.title}
  description={t.lead}
  currentPath="/la-struttura"
  schema={{ kind: 'lodging' }}
  breadcrumbItems={[{ label: NAV[lang].struttura }]}
>
  <StrutturaView lang={lang} />
</Layout>

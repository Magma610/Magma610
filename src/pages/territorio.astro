---
import Layout from '../layouts/Layout.astro';

const attivita = [
  {
    nome: 'Trekking sull\'Etna',
    img: 'https://images.unsplash.com/photo-1720210746040-c8cdca7ea391?fm=jpg&q=80&w=900&auto=format&fit=crop',
    testo: 'Sentieri per tutti i livelli tra crateri sommitali e boschi di quota, con punti panoramici sulla costa ionica.',
  },
  {
    nome: 'Cantine dell\'Etna',
    img: 'https://images.unsplash.com/photo-1596142332133-327e2a0ff006?fm=jpg&q=80&w=900&auto=format&fit=crop',
    testo: 'Vigneti su terreno vulcanico e cantine storiche a pochi minuti da Pedara — tour e degustazioni tutto l\'anno.',
  },
  {
    nome: 'Gole dell\'Alcantara',
    img: 'https://images.unsplash.com/photo-1760527806015-e15aa5844836?fm=jpg&q=80&w=900&auto=format&fit=crop',
    testo: 'Canyon di roccia basaltica scavato dal fiume Alcantara — una delle escursioni più suggestive della zona.',
  },
  {
    nome: 'Taormina',
    img: 'https://images.unsplash.com/photo-1523365154888-8a758819b722?fm=jpg&q=80&w=900&auto=format&fit=crop',
    testo: 'L\'eleganza della costa ionica, tra il Teatro Greco e le calette di Isola Bella, a mezz\'ora d\'auto.',
  },
];
---
<Layout
  title="Vivere il Territorio"
  description="Trekking sull'Etna, cantine, Gole dell'Alcantara e Taormina: cosa fare intorno a Magma 610, a Pedara."
>
  <section class="wrap page-hero">
    <span class="eyebrow">Attorno a Magma 610</span>
    <h1>Vivere il territorio</h1>
    <p class="lead">Dal cratere alla costa: il versante sud dell'Etna in quattro modi di scoprirlo.</p>
  </section>

  <section class="wrap territorio-list">
    {attivita.map((a, i) => (
      <div class={`territorio-row ${i % 2 === 1 ? 'reverse' : ''}`}>
        <img src={a.img} alt={a.nome} />
        <div>
          <h2>{a.nome}</h2>
          <p>{a.testo}</p>
        </div>
      </div>
    ))}
  </section>
</Layout>

<style>
  .page-hero { padding-top: 56px; padding-bottom: 16px; max-width: 720px; }
  .page-hero .eyebrow { color: var(--ginestra); font-weight: 700; font-size: 14px; }
  .page-hero h1 { font-size: 42px; margin: 10px 0 14px; }
  .page-hero .lead { color: var(--cenere); font-size: 17px; }

  .territorio-list { padding-top: 16px; }
  .territorio-row { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; margin-bottom: 64px; }
  .territorio-row.reverse { direction: rtl; }
  .territorio-row.reverse > * { direction: ltr; }
  .territorio-row img { border-radius: 20px; box-shadow: var(--shadow-card); aspect-ratio: 4/3; object-fit: cover; }
  .territorio-row h2 { font-size: 26px; margin-bottom: 14px; }
  .territorio-row p { color: var(--cenere); font-size: 15.5px; line-height: 1.7; }
  @media (max-width: 820px) {
    .territorio-row, .territorio-row.reverse { grid-template-columns: 1fr; direction: ltr; margin-bottom: 40px; }
  }
</style>

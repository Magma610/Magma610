---
import Layout from '../layouts/Layout.astro';
import ListingCard from '../components/ListingCard.astro';
import { listings } from '../data/listings.js';

// Foto stock temporanee (Unsplash) — da sostituire con scatti reali del territorio.
const IMG = {
  hero: 'https://images.unsplash.com/photo-1585901804315-82561e21b2c2?fm=jpg&q=80&w=1800&auto=format&fit=crop',
  terrTrekking: 'https://images.unsplash.com/photo-1720210746040-c8cdca7ea391?fm=jpg&q=80&w=700&auto=format&fit=crop',
  terrCantine: 'https://images.unsplash.com/photo-1596142332133-327e2a0ff006?fm=jpg&q=80&w=700&auto=format&fit=crop',
  terrAlcantara: 'https://images.unsplash.com/photo-1760527806015-e15aa5844836?fm=jpg&q=80&w=700&auto=format&fit=crop',
  terrTaormina: 'https://images.unsplash.com/photo-1523365154888-8a758819b722?fm=jpg&q=80&w=700&auto=format&fit=crop',
};
---
<Layout
  title="Home"
  description="B&B a conduzione diretta in pietra lavica a Pedara, sul versante sud dell'Etna. Due appartamenti indipendenti, Magma 102 e Magma 104."
>
  <div class="photo-note">Bozza — foto di Magma 102/104 reali dagli annunci Airbnb; territorio con foto stock temporanee</div>

  <section class="hero">
    <img class="hero-bg" src={IMG.hero} alt="Etna al tramonto" />
    <div class="hero-scrim"></div>
    <div class="hero-content">
      <div class="wrap">
        <div class="hero-text">
          <span class="kicker">Pedara — sul versante sud dell'Etna</span>
          <h1>Dormi ai piedi<br />del vulcano</h1>
          <p>Appartamenti indipendenti tra pietra lavica e ginestre, a due passi da sentieri, cantine e mare.</p>
        </div>
        <div class="search-pill">
          <div class="search-field"><label>Check-in</label><span>Aggiungi data</span></div>
          <div class="search-field"><label>Check-out</label><span>Aggiungi data</span></div>
          <div class="search-field"><label>Ospiti</label><span>2 ospiti</span></div>
          <a href="#camere" class="search-submit" aria-label="Vedi le camere">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap">
    <div class="pillars">
      <div class="pillar">
        <svg class="pillar-icon" viewBox="0 0 40 40" fill="none"><path d="M6 34V16L20 6l14 10v18" stroke="#C4401E" stroke-width="2" /><path d="M15 34V22h10v12" stroke="#C4401E" stroke-width="2" /></svg>
        <h3>La struttura</h3>
        <p>Corte interna in pietra lavica, ambienti curati nei dettagli e l'ospitalità di una casa vera, non di un hotel.</p>
        <a class="pillar-link" href="/la-struttura">Scopri la struttura →</a>
      </div>
      <div class="pillar">
        <svg class="pillar-icon" viewBox="0 0 40 40" fill="none"><rect x="6" y="12" width="28" height="20" rx="2" stroke="#C4401E" stroke-width="2" /><path d="M6 20h28M14 12v-4h12v4" stroke="#C4401E" stroke-width="2" /></svg>
        <h3>Le camere</h3>
        <p>Due appartamenti indipendenti, arredati con materiali del territorio, per soggiorni brevi e lunghi.</p>
        <a class="pillar-link" href="/camere">Vedi le camere →</a>
      </div>
      <div class="pillar">
        <svg class="pillar-icon" viewBox="0 0 40 40" fill="none"><path d="M4 30l10-16 6 9 6-12 10 19" stroke="#C4401E" stroke-width="2" stroke-linejoin="round" /></svg>
        <h3>Vivere il territorio</h3>
        <p>Trekking sull'Etna, cantine storiche, le Gole dell'Alcantara: la Sicilia autentica a portata di soggiorno.</p>
        <a class="pillar-link" href="/territorio">Esplora il territorio →</a>
      </div>
    </div>
  </section>

  <section class="wrap" id="camere">
    <div class="section-head">
      <span class="eyebrow">Dove dormire</span>
      <h2>Le camere</h2>
      <p>Due appartamenti indipendenti, con ingresso, servizi e corte propri — pensati per la privacy e la libertà del soggiorno.</p>
    </div>
    {listings.map((listing) => <ListingCard listing={listing} />)}
  </section>

  <section class="wrap">
    <div class="section-head">
      <span class="eyebrow">Attorno a Magma 610</span>
      <h2>Vivere il territorio</h2>
      <p>Dal cratere alla costa: quattro modi per scoprire cosa rende unico il versante sud dell'Etna.</p>
    </div>
    <div class="territorio-grid">
      <div class="territorio-item"><img src={IMG.terrTrekking} alt="Trekking sull'Etna" /><div class="territorio-label">Trekking sull'Etna</div></div>
      <div class="territorio-item"><img src={IMG.terrCantine} alt="Cantine dell'Etna" /><div class="territorio-label">Cantine dell'Etna</div></div>
      <div class="territorio-item"><img src={IMG.terrAlcantara} alt="Gole dell'Alcantara" /><div class="territorio-label">Gole dell'Alcantara</div></div>
      <div class="territorio-item"><img src={IMG.terrTaormina} alt="Taormina" /><div class="territorio-label">Taormina</div></div>
    </div>
  </section>

  <div class="review-strip">
    <div class="wrap">
      <div class="stars">★★★★★</div>
      <blockquote>"La corte interna e l'accoglienza fanno la differenza. Ci siamo svegliati con l'Etna davanti agli occhi ogni mattina."</blockquote>
      <cite>Recensione ospite — Google Business Profile</cite>
    </div>
  </div>

  <div class="cta-final">
    <div class="wrap">
      <h2>Prenota direttamente, senza intermediari</h2>
      <p>In futuro qui potrai prenotare senza uscire dal sito — per ora ti portiamo su Airbnb in un click.</p>
      <a href="#camere" class="btn-book">Vedi le camere</a>
    </div>
  </div>
</Layout>

<style>
  .photo-note { background: var(--pomice-light); text-align: center; padding: 12px 20px; font-size: 12.5px; color: var(--cenere); }

  .hero { position: relative; overflow: hidden; min-height: 600px; display: flex; align-items: flex-end; }
  .hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; }
  .hero-scrim { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(28,25,23,0.08) 0%, rgba(28,25,23,0.10) 35%, rgba(28,25,23,0.75) 100%); z-index: 1; }
  .hero-content { position: relative; z-index: 2; width: 100%; padding: 0 0 56px 0; }
  .hero-text { max-width: 640px; }
  .hero-text .kicker { font-size: 14px; color: #E9C77E; font-weight: 600; margin-bottom: 12px; display: block; }
  .hero-text h1 { font-size: 52px; color: var(--bianco); margin-bottom: 16px; }
  .hero-text p { font-size: 17px; color: rgba(255,252,247,0.88); max-width: 480px; margin-bottom: 28px; }
  @media (max-width: 640px) { .hero { min-height: 540px; } .hero-text h1 { font-size: 34px; } }

  .search-pill { background: var(--bianco); border-radius: var(--r-pill); display: flex; align-items: stretch; box-shadow: 0 14px 34px rgba(0,0,0,0.30); max-width: 720px; overflow: hidden; border: 1px solid rgba(28,25,23,0.08); }
  .search-field { flex: 1; min-width: 130px; padding: 12px 22px; border-right: 1px solid rgba(28,25,23,0.10); cursor: pointer; }
  .search-field:last-of-type { border-right: none; }
  .search-field label { display: block; font-size: 11px; font-weight: 700; color: var(--basalto); margin-bottom: 2px; }
  .search-field span { font-size: 13.5px; color: var(--cenere); }
  .search-submit { background: var(--lava); color: var(--bianco); border: none; width: 52px; margin: 6px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; flex-shrink: 0; }
  @media (max-width: 640px) { .search-pill { border-radius: 20px; flex-direction: column; } .search-field { border-right: none; border-bottom: 1px solid rgba(28,25,23,0.10); padding: 12px 18px; } .search-submit { border-radius: 14px; width: auto; margin: 8px 12px; } }

  .pillars { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .pillar { padding: 28px; border: 1px solid rgba(28,25,23,0.10); border-radius: var(--r-card); background: var(--bianco); box-shadow: var(--shadow-card); }
  .pillar-icon { width: 36px; height: 36px; margin-bottom: 18px; }
  .pillar h3 { font-size: 20px; margin-bottom: 10px; }
  .pillar p { color: var(--cenere); font-size: 14.5px; margin-bottom: 16px; }
  .pillar-link { font-size: 14px; font-weight: 700; color: var(--lava); }
  @media (max-width: 820px) { .pillars { grid-template-columns: 1fr; } }

  .territorio-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
  .territorio-item { position: relative; border-radius: 16px; overflow: hidden; aspect-ratio: 3/4; background: var(--basalto); box-shadow: var(--shadow-card); }
  .territorio-item img { width: 100%; height: 100%; object-fit: cover; position: absolute; inset: 0; }
  .territorio-label { position: absolute; left: 0; right: 0; bottom: 0; padding: 18px; background: linear-gradient(180deg, transparent, rgba(28,25,23,0.88)); color: var(--bianco); font-family: var(--font-display); font-size: 18px; z-index: 2; }
  @media (max-width: 880px) { .territorio-grid { grid-template-columns: repeat(2, 1fr); } }

  .review-strip { background: var(--basalto); color: var(--bianco); padding: 64px 0; }
  .review-strip blockquote { font-family: var(--font-display); font-size: 26px; font-weight: 400; max-width: 760px; margin: 0 auto 20px; text-align: center; }
  .review-strip .stars { color: var(--ginestra); font-size: 18px; margin-bottom: 18px; letter-spacing: 3px; text-align: center; }
  .review-strip cite { font-style: normal; font-size: 14px; color: rgba(255,252,247,0.65); display: block; text-align: center; }

  .cta-final { background: var(--pomice-light); text-align: center; padding: 88px 0; }
  .cta-final h2 { font-size: 32px; margin-bottom: 14px; max-width: 600px; margin-left: auto; margin-right: auto; }
  .cta-final p { color: var(--cenere); margin-bottom: 28px; }
</style>
